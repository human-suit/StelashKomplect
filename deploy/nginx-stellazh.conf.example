# /etc/nginx/sites-available/stellazhkomplect.ru
# sudo ln -s /etc/nginx/sites-available/stellazhkomplect.ru /etc/nginx/sites-enabled/
# sudo nginx -t && sudo systemctl reload nginx

upstream stellazh_next {
    server 127.0.0.1:3000;
    keepalive 64;
}

server {
    listen 80;
    listen [::]:80;
    server_name stellazhkomplect.ru www.stellazhkomplect.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name stellazhkomplect.ru www.stellazhkomplect.ru;

    # certbot --nginx -d stellazhkomplect.ru -d www.stellazhkomplect.ru
    ssl_certificate /etc/letsencrypt/live/stellazhkomplect.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stellazhkomplect.ru/privkey.pem;

    client_max_body_size 20m;

    location / {
        proxy_pass http://stellazh_next;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
